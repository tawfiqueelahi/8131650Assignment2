<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="8dp"
    android:background="#F6F8FC">

    <!-- Portal identity -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STUDENT PORTAL"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        android:textColor="#2563EB"
        android:layout_marginBottom="8dp" />

    <!-- Dashboard heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginBottom="6dp" />

    <!-- Dynamic entity count -->
    <TextView
        android:id="@+id/tvEntityCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading entities..."
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_marginBottom="16dp" />

    <!-- Blue accent -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:backgroundTint="#2563EB"
        android:background="@android:color/white"
        android:layout_marginBottom="22dp" />

    <!-- List section heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXPLORE ENTITIES"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textColor="#64748B"
        android:layout_marginBottom="14dp" />

    <!-- API loading indicator -->
    <ProgressBar
        android:id="@+id/dashboardProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="16dp"
        android:indeterminateTint="#2563EB"
        android:visibility="gone" />

    <!-- API error message -->
    <TextView
        android:id="@+id/tvDashboardError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="#B3261E"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Retry button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Try Again"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#2563EB"
        app:cornerRadius="14dp"
        android:visibility="gone" />

    <!-- RecyclerView: displays API entities -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewEntities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none" />

</LinearLayout>
